# 构建上下文：只保留镜像真正需要的文件，缩短构建时间并避免泄露
# （镜像实际 COPY 的只有 best_cf_ip_scanner.py、scanner/、docker/、data/、requirements.txt）

# 版本控制与仓库元数据
.git
.gitignore
.gitattributes
.github
.legacy

# 运行时目录（宿主数据，不进镜像）
output
cache
result

# 文档与许可证
docs
**/*.md
LICENSE

# 本地配置与密钥（镜像不需要 .env，运行时由 compose 注入）
.env
.env.*
**/.env
!.env.example

# 编排文件（镜像不依赖）
compose.yaml
compose.example.yaml
compose.build.yaml

# Python 缓存与虚拟环境
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.venv
venv
requirements-dev.txt

# 前端：只把源码送进构建阶段，本地依赖与产物不进上下文
web/node_modules
web/dist
web/.vite

# 面板运行期数据与计划工作区
panel-data
.superpowers

# 其它
tests
*.log
